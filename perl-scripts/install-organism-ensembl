#!/usr/bin/env perl
use JSON;
use HTTP::Tiny;

BEGIN {
  if ($0 =~ /([^(\/)]+)$/) {
    push (@INC, "$`lib/");
  }
}
require "RSA.lib";
use RSAT::server;

## Main package
package main;
{

  ################################################################
  ## Initialize parameters
  our $start_time = RSAT::util::StartScript();
  our $verbose = 0;

  our $ensembl_ftp_server = 'http://ftp.ebi.ac.uk';
  our $ensembl_ftp_path = 'pub/ensemblorganisms';
  our $ensembl_ftp_url = "$ensembl_ftp_server/$ensembl_ftp_path";
  our $ensembl_ftp_jsonfile = "$ensembl_ftp_url/species.json";
  our $ensembl_ftp_local_jsonfile = $ENV{RSAT}."/downloads/species.json";

  # local folder for genome data
  our $local_dir = $ENV{RSAT}."/public_html/data/genomes/";

  our $get_command = "wget";
  our $die_on_error = 1;

  ## Tasks to handle download and parsing of genomes from Ensembl
  our @tasks = qw(
      available
      download
      parse
      install
      default);
  our @default_tasks = qw(download parse install);
  our $supported_tasks = join(",", @tasks);

  our $parse_subtasks  = "split_features,parse_gtf,seq_len,parse_fasta";
  our $install_subtasks = "allup,upstream_freq,oligos,dyads,clean,config";

  my $null = "<NA>";
  my ($source,$taxonomy,$taxid) = ($null,$null,$null);
  our (%infile, %dir, %task, %downloads, %taxon, @user_tasks);

  ## File containing a list of organisms to install from Ensembl
  $infile{organisms} = "";

  ReadArguments();

  ################################################################
  ## Check parameter values

  if(scalar(@user_tasks) == 0) {
    RSAT::error::FatalError("You should specify at least one task.\nSupported tasks\n\t$supported_tasks\n");

  } elsif(!$task{available} && (scalar(@organisms)==0 && !$infile{organisms})) {
    RSAT::error::FatalError("You should choose at least one organism to install (-org, -org_file)\n");

  } elsif ($task{'default'}) {
    foreach my $t (@default_tasks) {
      $task{$t} = 1;
    }
    RSAT::message::Info("Default tasks selected: ", join(",", @default_tasks)) if ($main::verbose >= 2);
  }

  RSAT::util::CheckOutDir($local_dir);
  
  our %remaining_task = %task;

  if ($infile{organisms}) {
      ## If an organism file has been specified, read organism list
      my ($orgs) = &OpenInputFile($infile{organisms});
      while (<$orgs>) {
          next if (/^;/ || /^#/); ## Skip comment/header
          if(/^(\S+)/){  
            push(@organisms, $1)
	  }
      }
  }

  ################################################################
  ## Carry out tasks

  my ($genomeID);

  if ($task{available} || $task{download} || $task{parse} || $task{install}) {

    my ($data,$response,$json_string);
    my ($species_name,$species,$taxid,$assembly_id,$assembly,$assembly_name);
    my ($strain,$provider,$provider_data,$release,$release_node,$paths);
    my ($hmasked,$unmasked,$genes_gtf,$pep,$vcf);
    my ($md5file,$hmasked_idx,$unmasked_idx,$pep_idx);

    # make sure local Ensembl species file is up to date
    $response = HTTP::Tiny->new->mirror($ensembl_ftp_jsonfile, $ensembl_ftp_local_jsonfile);

    open(JSON,'<',$ensembl_ftp_local_jsonfile) ||
      RSAT::error::FatalError("Failed downloading $ensembl_ftp_url_jsonfile\n");
    $/ = undef;
    $json_string = <JSON>;
    close(JSON);

    $data = decode_json($json_string);
    $json_string = '';

    # loop across current species and extract relevants bits from JSON
    foreach $species_name (sort keys %{ $data->{species} }) {

      $species = $data->{species}{$species_name};
      $taxid = $species->{taxid} // '';
      $strain = $species->{strain} // '';

      foreach $assembly_id (sort keys %{ $species->{assemblies} }) {

        $assembly = $species->{assemblies}{$assembly_id};
        $assembly_name = $assembly->{name} // '';

        foreach $provider (sort keys %{ $assembly->{genebuild_providers} }) {
          $provider_data = $assembly->{genebuild_providers}{$provider};

          foreach $release (sort keys %{$provider_data}) {
            $release_node = $provider_data->{$release};
            $genomeID = "$species_name.$assembly_id.$release.$provider";

	    if($task{'download'} || $task{parse} || $task{install}) {
		   
              if(grep(/^$genomeID$/, @organisms)) {

                RSAT::message::Info("Found genomeID $genomeID") if ($main::verbose >= 2);

                $paths = $release_node->{paths};

		# bgzipped files, to be renamed as .gz
                $hmasked =
                  $assembly->{assembly}{files}{genome_sequences}{'hardmasked.fa.bgz'} // '';
                $unmasked = 
                  $assembly->{assembly}{files}{genome_sequences}{'unmasked.fa.bgz'} // '';
                $genes_gtf =  
	          $paths->{genebuild}{files}{annotations}{'genes.gtf.bgz'} // '';
                $pep =
                  $paths->{genebuild}{files}{annotations}{'pep.fa.bgz'} // '';
                $vcf =
                  $paths->{short_variants}{files}{variation_data}{'variation.vcf.gz'} // '';

		# files not listed in JSON, but found in FTP site
		$md5file      = $assembly->{assembly}{files}{genome_sequences}{'hardmasked.fa.bgz'};
		$md5file      =~ s/hardmasked.fa.bgz/md5sum.txt/; 
		$hmasked_idx  = $assembly->{assembly}{files}{genome_sequences}{'hardmasked.fa.bgz'} . '.fai';
		$unmasked_idx = $assembly->{assembly}{files}{genome_sequences}{'unmasked.fa.bgz'} . '.fai';
		$pep_idx      = $paths->{genebuild}{files}{annotations}{'pep.fa.bgz'} . '.fai';

                $downloads{$genomeID} = [
		  $unmasked,$hmasked,$pep,$genes_gtf,$vcf,
                  $md5file,$hmasked_idx,$unmasked_idx,$pep_idx
	        ];

		$filenames{$genomeID} = [
                  $genomeID.'.dna.genome.fa.gz',
                  $genomeID.'.dna_rm.genome.fa.gz',
                  $genomeID.'.pep.all.fa.gz',
                  $genomeID.'.gtf.gz',
		  $genomeID.'.vcf.gz',
	          'md5sum.txt',
		  $genomeID.'.dna_rm.genome.fa.gz.fai',
                  $genomeID.'.dna.genome.fa.gz.fai',
                  $genomeID.'.pep.all.fa.gz.fai' 
	        ];

	        $taxon{$genomeID} = $taxid; 
              }	   

            } else {
              print "$genomeID\t[$assembly_name, $strain]\n"
            }
          }
        }
      }
    }

  } 

  # any other remaining tasks
  my ($org_dir, $var_dir, $cmd, $cmd2, $f, $file, $localfile);
  foreach $genomeID (@organisms) {

    if ($task{download}) {

      # create/check destination folders
      $org_dir = "$local_dir/$genomeID/genome/";
      RSAT::util::CheckOutDir($org_dir);
      RSAT::message::Info("downloading $genomeID to $org_dir") if ($main::verbose >= 2);
   
      $var_dir = "$local_dir/$genomeID/variations/";
      RSAT::util::CheckOutDir($var_dir);

      if ($get_command eq "wget") {
        if ($main::verbose < 1) {
          $cmd = "$get_command -c --quiet";
        } else {
          $cmd = "$get_command -c -nv";
        } 

        foreach $f (0 .. $#{$downloads{$genomeID}}) {

          next if($downloads{$genomeID}->[$f] eq '');

          $file = $downloads{$genomeID}->[$f];
	  $localfile = $filenames{$genomeID}->[$f]; 

          if($localfile =~ /\.vcf\.gz$/) {
            doit("$cmd $ensembl_ftp_url/$file -O $var_dir$localfile", 0, $die_on_error, $main::verbose);

	    if(!-e "$var_dir$genomeID\.varBed") { 
	      $cmd2 = "convert-variations -i $var_dir$localfile -from vcf -to varBed -o $var_dir$genomeID\.varBed";
	      doit($cmd2, 0, $die_on_error, $main::verbose);
	    }

          } else {		  
            doit("$cmd $ensembl_ftp_url/$file -O $org_dir$localfile", 0, $die_on_error, $main::verbose);
          }  
        }
      }

      print "# $genomeID task: download OK\n"; 
    }  

    if ($task{parse}) {
      $org_dir = "$local_dir/$genomeID/genome/";
      RSAT::util::CheckOutDir($org_dir);
      RSAT::message::Info("parsing $genomeID files in $org_dir") if ($main::verbose >= 2);

      $cmd = "parse-gtf " .
        "-i $org_dir$genomeID.gtf.gz " .
        "-fasta_rm $org_dir$genomeID.dna_rm.genome.fa.gz " . 
        "-fasta $org_dir$genomeID.dna.genome.fa.gz " .
        "-fasta_pep $org_dir$genomeID.pep.all.fa.gz " .
        "-org_name $genomeID " .
        "-taxid $taxon{$genomeID} " .
        "-gtf_source Ensembl " .
        "-task $parse_subtasks " .	
        "-v $main::verbose " .
        "-o $org_dir ";
     
      doit($cmd, 0, $die_on_error, $main::verbose);
      RSAT::message::TimeWarn($cmd) if ($main::verbose >= 3);
    }
      
    if ($task{install}) {
      RSAT::message::Info("installing $genomeID") if ($main::verbose >= 2); 

      $cmd = "install-organism " .
        "-org $genomeID " .
        "-task $install_subtasks " .
        "-source Ensembl " .
	"-rm " .
        "-v $main::verbose ";
      
      doit($cmd, 0, $die_on_error, $main::verbose);
       RSAT::message::TimeWarn($cmd) if ($main::verbose >= 3);
    }
  }

  Finish($start_time);
}


################################################################
##################  SUBROUTINE DEFINITIONS  ####################
################################################################

sub Finish {
  my $start_time = (@_);	
  my $exec_time = RSAT::util::ReportExecutionTime($start_time);
  print $exec_time if ($main::verbose >= 1);
  exit(0);
}

################################################################
## Display full help message
sub PrintHelp {
    open HELP, "| more";
    print HELP <<End_of_help;
NAME
	install-organism-ensembl

AUTHOR
        Jacques van Helden (Jacques.van-Helden\@univ-amu.fr)
	Bruno Contreras Moreira (bcontreras\@eead.csic.es)

REQUIREMENTS

This program relies on wget to download genome files to the local machine.
It down

USAGE
     
        install-organism-ensembl -org Arabidopsis_thaliana.GCA_000001735.1.2010_09.community_araport11

	install-organism-ensembl -task available | grep Arabidopsis_thaliana > mylist.txt
	install-organism-ensembl -org_file mylist.txt -task default

DESCRIPTION
	Install organisms from Ensembl on the local RSAT instance.

	This script is a task manager, which (depending on the
	selected tasks) manages different steps necessary for the
	installation of an organism from flat files:

	- Downloading genome files from Ensembl, including vcf files when available.
          ($ensembl_ftp_url).

	- Parsing files and calculating oligonucleotide and dyad frequencies, which will
          be used as background models for motif discovery.

	- Adding the organism to local config file.

	- Installing the organism.

CATEGORY
	Data management.

OPTIONS
	-h	(must be first argument) display full help message
	-help	(must be first argument) display options
	-v	verbose

    ARGUMENTS

        -org    genomeID as provided by -task available, without spaces.
                The option -org can be repeated on the same command line 
                to iterate the installation over multiple organisms. Example:
                
		-org Arabidopsis_thaliana.GCA_000001735.1.2010_09.community_araport11

                which corresponds to 'Arabidopsis_thaliana',
		ENA/NCBI assembly 'GCA_000001735.1' and
		annotated geneset '2010_09', provided by 'community_araport11'
                
        -org_file organism_file_name
                Text file containing a list of genomeIDs to install.
                Only the first word of each row is considered.

	-dir    Absolute path of the installation directory, 
                default: $local_dir 

	-task	specification of a single installation task e.g.
			
                install-organism-ensembl -task available

		supported tasks: $supported_tasks

		Description of the tasks
		------------------------

		available    list available Ensembl species, parses large JSON file;
		             this task cannot be combined with any others.

		download     download genome from the Ensembl FTP site with wget
		             ($ensembl_ftp_url)

		parse        parse genome data (sequence, features) with parse-gtf

		install	     compute upstream freqs and install organism

		default      same as download,parse,install

SEE ALSO

    download-organisms

	The program I<download-organism> copies RSAT-formatted
	genomes from a RSAT server or repository. 

 	If a genome is available on the RSAT server, it is recommended
	to use download-genomes in order to obtain it immediately in
	the RSAT format, rather than install-genomes.

End_of_help
    close HELP;
    exit(0);
}

